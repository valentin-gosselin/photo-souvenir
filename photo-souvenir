LUT_DIRS = [
    Path.home() / '.local' / 'share' / 'photo-souvenir' / 'luts',
    Path(__file__).resolve().parent / 'luts' if __file__ else None,
]
LUT_DIRS = [p for p in LUT_DIRS if p]


def find_bundled_lut(filename):
    for d in LUT_DIRS:
        p = d / filename
        if p.is_file():
            return str(p)
    return None


def _icon_path():
    """Chemin de l'icone (installee ou bundlee a cote du script)."""
    for p in [Path.home() / '.local/share/icons/hicolor/scalable/apps/photo-souvenir.svg',
              Path(__file__).resolve().parent / 'photo-souvenir.svg' if __file__ else None]:
        if p and p.is_file():
            return str(p)
    return None



def detect_folder_lut(folder):
    """Cherche un .cube dans le dossier source. Prefere look.cube."""
    folder = Path(folder)
    cubes = sorted(folder.glob('*.cube'))
    if not cubes:
        return None
    preferred = next((p for p in cubes if p.stem.lower() == 'look'), None)
    return str(preferred or cubes[0])


def resolve_style_lut(preset_name, custom_lut_path):
    """Renvoie le chemin absolu vers un .cube a appliquer, ou None."""
    if preset_name == 'custom':
        return custom_lut_path if custom_lut_path else None
    preset = STYLE_PRESETS.get(preset_name)
    if not preset or 'cube' not in preset:
        return None
    return find_bundled_lut(preset['cube'])


def _ffmpeg_lut_path(lut):
    """Echappe les chars speciaux ffmpeg dans un chemin de .cube."""
    return lut.replace('\\', '\\\\').replace(':', '\\:').replace("'", "\\'")


# --- Detection des outils ---

def _which(name):
    return shutil.which(name)


def detect_tools():
    """Renvoie un dict outil->chemin (ou None). magick OU convert accepte."""
    tools = {
        'darktable-cli': _which('darktable-cli'),
        'ffmpeg': _which('ffmpeg'),
        'exiftool': _which('exiftool'),
    }
    tools['magick'] = _which('magick') or _which('convert')
    return tools


def missing_tools(tools):
    req = ['darktable-cli', 'ffmpeg', 'magick']
    return [t for t in req if not tools.get(t)]


# --- Parametres d'etalonnage ---

class Params:
    """Reglages d'etalonnage exposes a l'UI/CLI."""
    def __init__(self, target=0.38, contrast=6.0, lut_strength=78,
                 saturation=100, adaptive=True, quality=92, max_size=0,
                 denoise='off', noise_threshold=1.5, denoise_strength=1.0,
                 dt_style=None):
        self.target = target          # cible d'exposition (luminance moyenne 0..1)
        self.contrast = contrast      # force courbe S (sigmoidal) sur sombres/moyennes
        self.lut_strength = lut_strength  # % du LUT applique (sombres/moyennes)
        self.saturation = saturation  # saturation finale (modulate, sombres/moyennes)
        self.adaptive = adaptive      # attenue sur les photos claires
        self.quality = quality        # qualite JPEG
        self.max_size = max_size      # cote max en px (0 = pleine resolution)
        self.denoise = denoise        # 'off' | 'auto' | 'always'
        self.noise_threshold = noise_threshold  # sigma au-dela duquel on debruite (mode auto)
        self.denoise_strength = denoise_strength  # multiplicateur de force (1.0 = defaut)
        self.dt_style = dt_style      # nom d'un style darktable a appliquer au develop (ex. raw denoise)


def compute_params(mean, P):
    """Calcule les parametres effectifs d'une photo selon sa luminosite moyenne.

    En mode adaptatif, k va de 0 (image sombre/moyenne) a 1 (image claire) et
    attenue contraste/LUT/saturation pour eviter la sursaturation des photos
    ensoleillees. Renvoie (gamma, sigmoid_strength, lut_pct, saturation).
    """
    mean = max(0.001, min(0.999, mean))
    if P.adaptive:
        min_g = 0.82  # limite l'assombrissement des photos claires
        k = (mean - 0.25) / 0.30
        k = max(0.0, min(1.0, k))
    else:
        min_g = 0.45
        k = 0.0
    g = math.log(mean) / math.log(P.target)
    g = max(min_g, min(2.0, g))
    sig = P.contrast * (1.0 - 0.5 * k)        # jusqu'a -50% sur les claires
    lut_pct = int(round(P.lut_strength - 18 * k))   # jusqu'a -18 pts
    lut_pct = max(0, min(100, lut_pct))
    sat = int(round(P.saturation - 10 * k))   # jusqu'a -10
    return g, sig, lut_pct, sat


# --- Pipeline de traitement ---

def _run(cmd):
    return subprocess.run(cmd, stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode


def list_dt_styles():
    """Liste les styles darktable de l'utilisateur (hors styles camera _l10n)."""
    if not DT_USER_DATA.is_file():
        return []
    try:
        import sqlite3 as _sq
        con = _sq.connect(f'file:{DT_USER_DATA}?mode=ro', uri=True)
        rows = con.execute(
            "SELECT name FROM styles WHERE name NOT LIKE '\\_l10n%' ESCAPE '\\' "
            "ORDER BY name COLLATE NOCASE").fetchall()
        con.close()
        return [r[0] for r in rows]
    except Exception:
        return []


def dt_style_available(name):
    """Verifie qu'un style darktable existe dans la base de l'utilisateur."""
    return bool(name) and name in list_dt_styles()


def develop_raw(tools, raw, tif, configdir, dt_style=None):
    """RAW -> TIFF 16-bit via darktable-cli (orientation appliquee).

    Si dt_style est fourni, on copie la base darktable de l'utilisateur dans le
    configdir isole (pour y trouver le style) et on applique le style PAR-DESSUS
    le pipeline par defaut (sans --style-overwrite -> on garde demosaic, WB,
    sigmoid, etc., et on ajoute le module du style, ex. rawdenoise).
    """
    cmd = [tools['darktable-cli'], str(raw), str(tif), '--hq', 'true']
    if dt_style and DT_USER_DATA.is_file():
        try:
            shutil.copy2(DT_USER_DATA, Path(configdir) / 'data.db')
            cmd += ['--style', dt_style]
        except Exception:
            pass
    cmd += ['--core', '--library', ':memory:', '--configdir', str(configdir)]
    _run(cmd)
    return Path(tif).is_file()


def measure_mean(tools, tif):
    """Luminance moyenne 0..1 (sur une version reduite, rapide)."""
    out = subprocess.run(
        [tools['magick'], str(tif), '-resize', '300x',
         '-colorspace', 'Gray', '-format', '%[fx:mean]', 'info:'],
        capture_output=True, text=True)
    try:
        return float(out.stdout.strip())
    except ValueError:
        return 0.4


def estimate_noise(tif, tile=96, low_pct=20):
    """Estime le bruit (sigma en niveaux 0-255) sur le TIFF plein-res.

    Estimateur de Immerkaer par tuiles : on convolue avec un noyau qui annule
    les gradients lisses et les contours lineaires, puis sigma ~ MAD de la
    reponse ; on prend un percentile bas (tuiles les plus plates) pour isoler
    le bruit capteur du detail. Renvoie None si numpy/PIL indisponibles.
    """
    try:
        import numpy as np
        from numpy.lib.stride_tricks import sliding_window_view
        from PIL import Image
    except ImportError:
        return None
    try:
        a = np.asarray(Image.open(tif).convert('L'), dtype=np.float64)
        if a.max() > 255:
            a = a / 257.0
        K = np.array([[1, -2, 1], [-2, 4, -2], [1, -2, 1]], dtype=np.float64)
        resp = np.abs((sliding_window_view(a, (3, 3)) * K).sum(axis=(-1, -2)))
        c = math.sqrt(math.pi / 2) / 6.0
        th, tw = resp.shape
        sig = [c * resp[y:y+tile, x:x+tile].mean()
               for y in range(0, th, tile) for x in range(0, tw, tile)
               if resp[y:y+tile, x:x+tile].size >= 64]
        return float(np.percentile(np.array(sig), low_pct)) if sig else 0.0
    except Exception:
        return None


def _iso_noise_fallback(tools, raw):
    """Faute de numpy, estime un sigma approximatif depuis l'ISO EXIF."""
    if not tools.get('exiftool'):
        return None
    out = subprocess.run([tools['exiftool'], '-q', '-s3', '-ISO', str(raw)],
                         capture_output=True, text=True)
    try:
        iso = float(out.stdout.strip().split()[0])
    except (ValueError, IndexError):
        return None
    # calage empirique : ISO200~0.4, 8000~2.1, 51200~3.8
    return round(0.4 + 0.0009 * max(0, iso - 200), 2)


def denoise_tif(tools, in_tif, out_tif, sigma, strength=1.0):
    """Debruitage adaptatif dose selon sigma (et un multiplicateur de force).

    1) mediane sur les canaux chroma (a&b du LAB) -> tue les points colores ;
    2) nlmeans sur la luminance -> enleve le grain (meilleur que hqdn3d, plus
       lent). Force et fenetres mises a l'echelle de sigma * strength. Sortie
       forcee en sRGB (ffmpeg ecrit du YCbCr sinon -> derive magenta).
    """
    cw = int(max(3, min(13, round(sigma * 1.6 * strength) | 1)))   # fenetre chroma impaire
    tmp = Path(out_tif).with_suffix('.chroma.tif')
    _run([tools['magick'], str(in_tif), '-colorspace', 'LAB',
          '-channel', 'GB', '-statistic', 'median', f'{cw}x{cw}',
          '+channel', '-colorspace', 'sRGB', str(tmp)])
    nl = int(max(2, min(22, round(sigma * 1.8 * strength))))       # force nlmeans
    rc = _run([tools['ffmpeg'], '-nostdin', '-loglevel', 'error', '-y',
               '-i', str(tmp), '-vf', f'nlmeans=s={nl}:p=7:r=15',
               '-pix_fmt', 'rgb24', str(out_tif)])
    tmp.unlink(missing_ok=True)
    if rc == 0 and Path(out_tif).is_file():
        return cw, nl
    # echec nlmeans : on garde au moins la version chroma
    if tmp.is_file():
        shutil.move(str(tmp), str(out_tif))
    return cw, 0


def grade(tools, tif, out_jpg, lut, P, workdir):
    """Applique exposition + contraste + LUT dose + saturation -> JPEG."""
    mean = measure_mean(tools, tif)
    g, sig, lut_pct, sat = compute_params(mean, P)

    pre = Path(workdir) / 'pre.tif'
    # 1) correction primaire : expo (gamma) + noirs/blancs + contraste S
    cmd = [tools['magick'], str(tif), '-gamma', f'{g:.4f}',
           '-level', '1%,99.5%', '-sigmoidal-contrast', f'{sig:.2f}x47%']
    if P.max_size and P.max_size > 0:
        cmd += ['-resize', f'{P.max_size}x{P.max_size}>']
    cmd += [str(pre)]
    _run(cmd)

    src_for_lut = pre
    if lut and lut_pct > 0:
        lutimg = Path(workdir) / 'lut.tif'
        safe = _ffmpeg_lut_path(lut)
        _run([tools['ffmpeg'], '-nostdin', '-loglevel', 'error', '-y',
              '-i', str(pre), '-vf', f"lut3d='{safe}'", str(lutimg)])
        # 2) melange LUT a lut_pct% + reste de l'image corrigee
        inv = 100 - lut_pct
        _run([tools['magick'], str(pre), str(lutimg),
              '-compose', 'blend', '-define', f'compose:args={lut_pct},{inv}',
              '-composite', '-level', '1.5%,100%',
              '-modulate', f'100,{sat},100', '-quality', str(P.quality),
              str(out_jpg)])
        lutimg.unlink(missing_ok=True)
    else:
        # pas de LUT : juste noirs profonds + saturation
        _run([tools['magick'], str(pre), '-level', '1.5%,100%',
              '-modulate', f'100,{sat},100', '-quality', str(P.quality),
              str(out_jpg)])
    pre.unlink(missing_ok=True)
    return mean, lut_pct, sat


def copy_metadata(tools, raw, jpg):
    """Recopie EXIF/XMP d'origine mais remet l'orientation a normal."""
    if not tools.get('exiftool'):
        return
    subprocess.run(
        [tools['exiftool'], '-q', '-overwrite_original', '-TagsFromFile', str(raw),
         '-EXIF:all', '-XMP:all', '-Orientation#=1', str(jpg)],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def process_one(tools, raw, out_dir, lut, P):
    """Traite une photo RAW de bout en bout. Renvoie (nom, ok, info)."""
    raw = Path(raw)
    out_jpg = Path(out_dir) / (raw.stem + '.jpg')
    workdir = Path(tempfile.mkdtemp(prefix='photosouv-'))
    configdir = workdir / 'dtcfg'
    configdir.mkdir(exist_ok=True)
    try:
        tif = workdir / (raw.stem + '.tif')
        if not develop_raw(tools, raw, tif, configdir, P.dt_style):
            return raw.name, False, 'échec développement'

        # detection du grain + debruitage adaptatif (avant l'eclaircissement)
        dn_info = ''
        if P.denoise != 'off':
            sigma = estimate_noise(tif)
            if sigma is None:
                sigma = _iso_noise_fallback(tools, raw)
            if sigma is not None:
                apply = (P.denoise == 'always') or (sigma >= P.noise_threshold)
                if apply:
                    dn = workdir / (raw.stem + '_dn.tif')
                    cw, nl = denoise_tif(tools, tif, dn, sigma, P.denoise_strength)
                    if dn.is_file():
                        tif.unlink(missing_ok=True)
                        tif = dn
                    dn_info = f' bruit σ={sigma:.1f}->débruité(chroma {cw}px,nlmeans {nl})'
                else:
                    dn_info = f' bruit σ={sigma:.1f} (sous seuil)'

        mean, lut_pct, sat = grade(tools, tif, out_jpg, lut, P, workdir)
        copy_metadata(tools, raw, out_jpg)
        return raw.name, True, f'mean={mean:.3f} LUT={lut_pct}% sat={sat}{dn_info}'
    except Exception as e:
        return raw.name, False, str(e)
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


def scan_folder(folder):
    """Liste les RAW du dossier, tries par nom (= chronologique en general)."""
    folder = Path(folder)
    return sorted([p for p in folder.iterdir()
                   if p.is_file() and p.suffix.lower() in RAW_EXTS])


def process_folder(folder, out_dir, lut, P, tools, workers=3,
                   log=print, progress=None, should_stop=None):
    """Traite tout un dossier en parallele. Renvoie (ok, ko)."""
    raws = scan_folder(folder)
    if not raws:
        log("Aucun fichier RAW trouvé dans le dossier.")
        return 0, 0
    Path(out_dir).mkdir(parents=True, exist_ok=True)
    if P.dt_style:
        if dt_style_available(P.dt_style):
            log(f"Style darktable appliqué au développement : '{P.dt_style}'")
        else:
            log(f"ATTENTION : style darktable '{P.dt_style}' introuvable -> ignoré.")
            P.dt_style = None
    log(f"{len(raws)} photos RAW à traiter -> {out_dir}")
    ok = ko = 0
    done = 0
    with ThreadPoolExecutor(max_workers=workers) as ex:
        futs = {ex.submit(process_one, tools, r, out_dir, lut, P): r for r in raws}
        for fut in as_completed(futs):
            if should_stop and should_stop():
                log("Interrompu.")
                break
            name, success, info = fut.result()
            done += 1
            if success:
                ok += 1
                log(f"[{done}/{len(raws)}] {name} -> OK ({info})")
            else:
                ko += 1
                log(f"[{done}/{len(raws)}] {name} -> ÉCHEC ({info})")
            if progress:
                progress(int(done * 100 / len(raws)))
    log(f"Terminé : {ok} OK, {ko} échecs. Sortie : {out_dir}")
    return ok, ko


# --- CLI ---

def run_cli(args):
    folder = Path(args.folder)
    if not folder.is_dir():
        print(f"Erreur: '{folder}' n'est pas un dossier", file=sys.stderr)
        return 1

    tools = detect_tools()
    miss = missing_tools(tools)
    if miss:
        print(f"Outils manquants: {', '.join(miss)}", file=sys.stderr)
        print("  sudo dnf install darktable ImageMagick ffmpeg perl-Image-ExifTool",
              file=sys.stderr)
        return 1

    style = args.style
    custom_lut = args.custom_lut
    if not custom_lut and style in ('neutral', 'portrait'):
        auto = detect_folder_lut(folder)
        if auto and args.style == 'neutral':
            print(f"LUT détectée dans le dossier: {auto} -> style=custom")
            style, custom_lut = 'custom', auto
    lut = resolve_style_lut(style, custom_lut)
    if style not in ('neutral',) and not lut:
        print(f"Style '{style}': LUT introuvable, fallback neutre.", file=sys.stderr)

    out_dir = args.output or str(folder / 'export')
    P = Params(target=args.target, contrast=args.contrast,
               lut_strength=args.lut_strength, saturation=args.saturation,
               adaptive=args.adaptive, quality=args.quality, max_size=args.max_size,
               denoise=args.denoise, noise_threshold=args.noise_threshold,
               denoise_strength=args.denoise_strength, dt_style=args.dt_style)

    print(f"Style: {style}" + (f" ({Path(lut).name})" if lut else ""))
    print(f"Adaptatif: {'oui' if P.adaptive else 'non'} | cible={P.target} "
          f"contraste={P.contrast} LUT={P.lut_strength}% satu={P.saturation} q={P.quality}")
    if P.denoise != 'off':
        seuil = "toujours" if P.denoise == 'always' else f"si σ>={P.noise_threshold}"
        print(f"Débruitage: {P.denoise} ({seuil})")
    ok, ko = process_folder(folder, out_dir, lut, P, tools, workers=args.workers)
    return 0 if ko == 0 else 2


# --- UI ---

def run_ui():
    try:
        from PySide6.QtCore import Qt, QThread, Signal
        from PySide6.QtGui import QFont, QIcon
        from PySide6.QtWidgets import (
            QApplication, QCheckBox, QComboBox, QDoubleSpinBox, QFileDialog,
            QGridLayout, QGroupBox, QHBoxLayout, QLabel, QLineEdit, QMainWindow,
            QMessageBox, QProgressBar, QPushButton, QSpinBox, QTextEdit,
            QVBoxLayout, QWidget,
        )
    except ImportError:
        print("PySide6 manque. Installe avec:", file=sys.stderr)
        print(f"  {sys.executable} -m pip install PySide6", file=sys.stderr)
        return 1

    class StyleCombo(QComboBox):
        """Combo des styles darktable, rafraichi a chaque ouverture du menu."""
        def showPopup(self):
            current = self.currentText()
            self.blockSignals(True)
            self.clear()
            self.addItem("(aucun)")
            self.addItems(list_dt_styles())
            idx = self.findText(current)
            self.setCurrentIndex(idx if idx >= 0 else 0)
            self.blockSignals(False)
            super().showPopup()

    class Worker(QThread):
        log_line = Signal(str)
        progress_pct = Signal(int)
        done = Signal(int, int)

        def __init__(self, folder, out_dir, lut, P, tools, workers):
            super().__init__()
            self.folder = folder
            self.out_dir = out_dir
            self.lut = lut
            self.P = P
            self.tools = tools
            self.workers = workers
            self._stop = False

        def stop(self):
            self._stop = True

        def run(self):
            ok, ko = process_folder(
                self.folder, self.out_dir, self.lut, self.P, self.tools,
                workers=self.workers, log=self.log_line.emit,
                progress=self.progress_pct.emit, should_stop=lambda: self._stop)
            self.done.emit(ok, ko)

    class MainWindow(QMainWindow):
        def __init__(self):
            super().__init__()
            self.setWindowTitle("Photo Souvenir")
            self.resize(880, 760)
            self.tools = detect_tools()
            self.worker = None
            self._build_ui()
            self._check_tools()

        def _build_ui(self):
            central = QWidget()
            self.setCentralWidget(central)
            layout = QVBoxLayout(central)

            header = QLabel(
                "<h2 style='margin:0'>Photo Souvenir</h2>"
                "<p style='margin:0;color:#888'>Développe et étalonne tout un lot de "
                "photos RAW avec un look film, en mode auto adaptatif.</p>")
            layout.addWidget(header)

            folder_group = QGroupBox("Dossier source (photos RAW)")
            fl = QHBoxLayout(folder_group)
            self.folder_edit = QLineEdit()
            self.folder_edit.setPlaceholderText("Dossier contenant tes .ARW / .CR3 / .NEF ...")
            self.folder_edit.textChanged.connect(self._update_out_default)
            browse = QPushButton("Parcourir...")
            browse.clicked.connect(self.browse_folder)
            fl.addWidget(self.folder_edit, 1)
            fl.addWidget(browse)
            layout.addWidget(folder_group)

            opts = QGroupBox("Look & étalonnage")
            g = QGridLayout(opts)

            g.addWidget(QLabel("Style (LUT):"), 0, 0)
            self.style_combo = QComboBox()
            for _, label in STYLE_LABELS:
                self.style_combo.addItem(label)
            self.style_combo.currentIndexChanged.connect(self._on_style_changed)
            g.addWidget(self.style_combo, 0, 1)
            self.lut_edit = QLineEdit()
            self.lut_edit.setPlaceholderText("(custom .cube)")
            self.lut_edit.setEnabled(False)
            self.lut_btn = QPushButton("LUT...")
            self.lut_btn.setEnabled(False)
            self.lut_btn.clicked.connect(self._browse_lut)
            g.addWidget(self.lut_edit, 0, 2)
            g.addWidget(self.lut_btn, 0, 3)

